{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "src/**/*",
    "prisma/**/*",
    "routes",
    "index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
