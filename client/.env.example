# Must point to the SAME database as the server
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public"

# Must MATCH the server's JWT_SECRET
JWT_SECRET="choose-a-strong-secret"

# NextAuth (optional OAuth). Email/password works without these.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="choose-a-strong-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
